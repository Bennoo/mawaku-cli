class Mawaku < Formula
  desc "Command-line tool scaffold for generating video call backgrounds"
  homepage "https://github.com/Bennoo/mawaku-cli"
  version "__VERSION__"
  license "MIT OR Apache-2.0"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/Bennoo/mawaku-cli/releases/download/__REF__/mawaku-__REF__-macos-arm64.tar.gz"
      sha256 "__SHA_MACOS_ARM64__"
    else
      url "https://github.com/Bennoo/mawaku-cli/releases/download/__REF__/mawaku-__REF__-macos-x86_64.tar.gz"
      sha256 "__SHA_MACOS_X86_64__"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/Bennoo/mawaku-cli/releases/download/__REF__/mawaku-__REF__-linux-arm64.tar.gz"
      sha256 "__SHA_LINUX_ARM64__"
    else
      url "https://github.com/Bennoo/mawaku-cli/releases/download/__REF__/mawaku-__REF__-linux-x86_64.tar.gz"
      sha256 "__SHA_LINUX_X86_64__"
    end
  end

  def install
    bin.install "mawaku"
  end

  test do
    system "#{bin}/mawaku", "--version"
  end
end
